# Git LFS — track model weight files
# This lets GitHub handle large .pt files without bloating the repo.
# Install Git LFS: https://git-lfs.com/  then run: git lfs install

*.pt filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
